<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.green.greenshare.profile.mapper.ProfileMapper">
    <!-- 쿼리 작성 -->

    <!--프로필 이미지 등록하는 쿼리-->
    <insert id="insertProfileImage" parameterType="ProfileDTO">
        INSERT INTO profile_images (USER_EMAIL, IMAGE_DATA)
        VALUES (#{userEmail}, #{imageData})
    </insert>

    <select id="selectLatestProfile" parameterType="string" resultType="ProfileDTO">
        SELECT *
        FROM profile_images
        WHERE USER_EMAIL = #{userEmail}
        ORDER BY CREATED_AT DESC
        LIMIT 1
    </select>

</mapper>
