<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.green.greenshare.user.mapper.UserMapper">



    <resultMap id="user" type="UserDTO">
        <id column="USER_EMAIL" property="userEmail"/>
        <result column="USER_PASSWORD" property="userPassword"/>
        <result column="USER_NAME" property="userName"/>
        <result column="USER_ROLE" property="userRole"/>
        <result column="JOIN_DATA" property="joinData"/>
    </resultMap>

    <!--로그인하려는 회원 정보 조회-->
    <select id="getUserForLogin" resultMap="user">
        SELECT USER_EMAIL
        , USER_PASSWORD
        , USER_ROLE
        , USER_NAME
        FROM USER
        WHERE USER_EMAIL = #{userEmail}
    </select>





    <insert id="insertUserList">
        INSERT INTO USER(
        USER_EMAIL,
        USER_PASSWORD,
        USER_TEL,
        USER_NAME
        )
        VALUES(
        #{userEmail},
        #{userPassword},
        #{userTel},
        #{userName}
        )
    </insert>
</mapper>

