<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.green.greenshare.user.UserMapper">
    <!--QNA 목록 조회-->
    <select id="qnaList" resultType="UserDTO">
        SELECT * FROM QNA_BOARD
        <if test='searchLog != null and !searchLog.equals("")'>
            WHERE ${selectWord} LIKE CONCAT ('%',#{searchLog}, '%')
        </if>
    </select>

    <!--QNA 상세보기-->
    <select id="selectQna" resultType="UserDTO">
        SELECT * FROM QNA_BOARD
        WHERE QNA_NUM = #{qnaNum}
    </select>

    <!--QNA 등록-->
    <insert id="insertQna">
        INSERT INTO QNA_BOARD(
        TITLE,
        WRITER,
        CONTENT,
        DATE,
        STATUS
        )
        VALUES(
        #{title},
        #{writer},
        #{content},
        #{date},
        #{status}
        )
    </insert>

    <!--QNA 수정-->
    <update id="updateQna">
        UPDATE SET
        CONTENT = #{content}
        TITLE = #{title}
    </update>
    <!--QNA 질문 삭제-->
    <delete id="deleteQna">
        DELETE FROM QNA_BOARD
        WHERE QNA_NUM = #{qnaNum}
    </delete>


    <resultMap id="user" type="UserDTO">
        <id column="USER_EMAIL" property="userEmail"/>
        <result column="USER_PASSWORD" property="userPassword"/>
        <result column="USER_NAME" property="userName"/>
        <result column="USER_ROLE" property="userRole"/>
        <result column="JOIN_DATA" property="joinData"/>
    </resultMap>

    <!--로그인하려는 회원 정보 조회-->
    <select id="getUserForLogin" resultMap="user">
        SELECT USER_EMAIL
        , USER_PASSWORD
        , USER_ROLE
        , USER_NAME
        FROM USER
        WHERE USER_EMAIL = #{userEmail}
    </select>





    <insert id="insertUserList">
        INSERT INTO USER(
        USER_EMAIL,
        USER_PASSWORD,
        USER_TEL,
        USER_NAME
        )
        VALUES(
        #{userEmail},
        #{userPassword},
        #{userTel},
        #{userName}
        )
    </insert>
</mapper>

