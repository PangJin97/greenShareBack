<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.green.greenshare.User.mapper.UserMapper">
    <!-- 쿼리 작성 -->

    <insert id="insertUserList">
        INSERT INTO USER(
        USER_EMAIL,
        USER_PASSWORD,
        USER_TEL,
         USER_NAME
        )
        VALUES(
        #{userEmail},
        #{userPassword},
        #{userTel},
        #{userName}
        )
    </insert>






</mapper>